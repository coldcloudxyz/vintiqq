# Razorpay Dashboard → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google Apps Script Web App URL that appends paid orders to your Sheet
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/REPLACE_ME/exec
GOOGLE_SHEETS_SHARED_SECRET=replace-with-a-long-random-secret

PORT=3000
