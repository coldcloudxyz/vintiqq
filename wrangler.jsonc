{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "vintiqq",
  "main": "worker.js",
  "compatibility_date": "2026-09-26",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "secrets": {
    "required": [
      "RAZORPAY_KEY_ID",
      "RAZORPAY_KEY_SECRET",
      "GOOGLE_SHEETS_WEBHOOK_URL",
      "GOOGLE_SHEETS_SHARED_SECRET"
    ]
  }
}
